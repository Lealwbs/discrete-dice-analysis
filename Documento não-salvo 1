#include "aluno.hpp"
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <iomanip>

int main() {
    std::vector<Aluno> alunos;
    std::string nome;

    // Entrada dos dados
    while (true) {
        std::getline(std::cin, nome);
        if (nome == "END") break;

        int matricula;
        std::cin >> matricula;

        std::vector<int> notas;
        int nota;
        while (std::cin >> nota && nota != -1) {
            notas.push_back(nota);
        }
        std::cin.ignore(); // Ignora o caractere de nova linha residual

        alunos.emplace_back(nome, matricula, notas);
    }

    // Ordenar os alunos pelo nome
    std::sort(alunos.begin(), alunos.end(), [](const Aluno& a, const Aluno& b) {
        return a.getNome() < b.getNome();
    });

    // Relatório
    for (const auto& aluno : alunos) {
        std::cout << aluno.getMatricula() << " " << aluno.getNome() << " ";
        for (int nota : aluno.getNotas()) {
            std::cout << nota << " ";
        }
        std::cout << "\n";

        std::cout << std::fixed << std::setprecision(2) 
                  << aluno.calcularMedia() << " " 
                  << aluno.notaMaxima() << " " 
                  << aluno.notaMinima() << "\n";
    }

    return 0;
}




